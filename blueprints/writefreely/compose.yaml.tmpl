# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# This is the writefreely-wisp fork, not upstream WriteFreely. The fork keeps
# its data in Postgres and its uploads in Garage, so it joins the same cluster
# and the same object store as everything else instead of a SQLite file and a
# local disk nothing else can reach.
{{- if .App.Pinned }}
# {{ .App.Name }} is pinned to {{ .App.Site }}: app, database and media
# together. A half pinned app needs both its own location and the cluster site
# to be reachable, which makes it less available than either alone.
{{- else }}
# {{ .App.Name }} has cluster placement: no Postgres service of its own, and a
# connection to the local HAProxy on {{ .DBHost }}:{{ .DBPort }}.
{{- end }}
name: {{ .Project }}

services:
  app:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ .Image "app" }}
    restart: unless-stopped
    # Root, not the image's writefreely user (uid 1000). `paisans deployment apply`
    # writes config.ini as root at 0600, and Docker creates data/ as root,
    # so as uid 1000 the fork can neither read its configuration nor write
    # its keys into /data, and exits at startup. Dropping to uid 1000 after a
    # chown cannot work here: config.ini is a read-only bind, so it cannot be
    # chowned from inside, and it has to stay 0600 because it holds the
    # database password and the SSO client secret.
    user: "0:0"
    # The mesh address only. Docker's own iptables rules bypass a host
    # firewall, so a port published on every interface of a host with a
    # public address is reachable from the internet whatever ufw says. The
    # gateway, over the mesh, is the only thing that should reach it.
    ports:
      - "{{ .MeshAddress }}:{{ .App.Port }}:{{ .App.Port }}"
    # Replaces the image's own, which probes port 8080, WriteFreely's
    # default. This blueprint serves on {{ .App.Port }}, so the image's check
    # marks a working blog unhealthy and `paisans deployment apply` stops on it.
    # /healthz answers 200 only when the database does (blueprint.yaml).
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ .App.Port }}/healthz"]
      interval: 15s
      timeout: 5s
      start_period: 30s
    volumes:
      - {{ .DataPath }}/data:/data
      # WriteFreely reads a file, not an environment. Its SSO client secret is
      # in here, which is why it is bind mounted at 0600 rather than passed as
      # environment: `docker inspect` and /proc/<pid>/environ would show the
      # latter.
      - {{ .DataPath }}/config.ini:/data/config.ini:ro
{{- if .App.Pinned }}
    # Started, and restarted, only once postgres answers. The bare list form
    # waits for the container alone, and `docker compose restart` waits for no
    # dependency without restart: true, so restarting the stack raced the
    # database and failed the apply on a lookup of a name not yet registered.
    depends_on:
      postgres:
        condition: service_healthy
        restart: true

  postgres:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ .Image "postgres" }}
    restart: unless-stopped
    # Ready once it answers over TCP. The image's first start runs initdb
    # against a server listening on its socket alone, so a check over the
    # socket would pass before the real server is up. The start period covers
    # that initdb, and the start interval asks every second within it, so the
    # services that wait for this one start within a second of it.
    healthcheck:
      test: ["CMD", "pg_isready", "-h", "127.0.0.1", "-U", "{{ .DBUser }}", "-d", "{{ .DBName }}"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 5m
      start_interval: 1s
    environment:
      POSTGRES_DB: {{ .DBName }}
      POSTGRES_USER: {{ .DBUser }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
    volumes:
      - {{ .DataPath }}/postgres:{{ .PostgresDataMount }}
{{- end }}

# Every network carries the deployment label too, so that what owns it is
# read from the label rather than guessed from its name.
networks:
  default:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"

/* Paisans Blog (WriteFreely-wisp) instance CSS, served as /local/custom.css.
   October 17: phone account navigation. November 3: Paisans house style.
   CSS only; WriteFreely markup, auth and the writer's per-post font choice
   (serif / sans / mono) are unchanged. */
@import url('https://fonts.googleapis.com/css2?family=Delius+Swash+Caps&family=Nunito:wght@400;600;700;800;900;1000&display=swap');

/* WriteFreely-wisp multi-user account pages: keep the action out of tab flow. */
@media (max-width: 600px) {
  body#me > header.multiuser #full-nav > #user-nav {
    max-width: 100%;
    margin-left: 0;
  }
  body#me > header.multiuser #user-nav > .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1.25rem;
    margin: .75rem 0 0;
  }
  body#me > header.multiuser #user-nav > .tabs > a + a {
    margin-left: 0;
  }
  body#me > header.multiuser #full-nav > .right-side {
    float: none;
    clear: both;
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
  }
}

/* House style, November 3 2026 */
:root {
  --ps-paper: #F6F3EA; --ps-surface: #FFFFFF; --ps-ink: #1F3A2D; --ps-text: #2D3B31;
  --ps-muted: #667060; --ps-line: #E3E4D7; --ps-line-2: #D2D8C6; --ps-sage: #ECEFE1;
  --ps-sage-2: #DFE6CF; --ps-olive: #5B7339; --ps-olive-2: #4A5F2E; --ps-on-olive: #FFFFFF;
  --ps-leaf: #7F9C47;
  --ps-font: 'Nunito', ui-rounded, system-ui, -apple-system, 'Segoe UI', sans-serif;
  --ps-hand: 'Delius Swash Caps', 'Nunito', cursive;
}
/* WriteFreely only darkens sign-in and account pages; keep that scope. */
@media (prefers-color-scheme: dark) {
  body#login, body#me {
    --ps-paper: #11150F; --ps-surface: #1A1F17; --ps-ink: #EEF0E5; --ps-text: #D8DDCF;
    --ps-muted: #9AA48F; --ps-line: #2B3227; --ps-line-2: #3A4335; --ps-sage: #232B1F;
    --ps-sage-2: #2D3727; --ps-olive: #A6BF78; --ps-olive-2: #B9D08D; --ps-on-olive: #15200F;
    --ps-leaf: #A6BF78;
  }
}

body:not(.dark), body#login, body#me { background-color: var(--ps-paper) !important; color: var(--ps-text) !important; }
body#login h1, body#me h1, body#me #official-writing h2, body#me #official-writing h3 { color: var(--ps-ink); }
body, header, nav, footer, button, input, select, textarea.inputform, .btn,
#official-writing, #wrapper > h1, .post-title time, .alert {
  font-family: var(--ps-font);
}
body:not(.dark) a, body#login a, body#me a { color: var(--ps-ink); }
body:not(.dark) a:hover { color: var(--ps-olive); }
:focus-visible { outline: 3px solid var(--ps-leaf); outline-offset: 2px; }

/* Instance header: "Blog." wordmark in place of the site name. */
body:not(#collection):not(#post):not(#subpage) header h2 > a[href="/"] {
  display: inline-block; overflow: hidden; white-space: nowrap; vertical-align: middle;
  height: 1.1em; font: 1000 28px/1.1 var(--ps-font) !important;
  letter-spacing: -.012em; color: transparent !important; text-decoration: none; transition: none;
}
/* One pseudo-element, the dot coloured by a clipped gradient, so the hidden site name never splits it.
   The colour changes exactly at the dot's advance (0.273em in Nunito 1000; "g." is not kerned), so no leaf reaches the g. */
body:not(#collection):not(#post):not(#subpage) header h2 > a[href="/"]::before {
  content: 'Blog.'; display: block;
  background: linear-gradient(90deg, var(--ps-ink) 0 calc(100% - .273em), var(--ps-leaf) calc(100% - .273em));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  width: max-content;
}
header nav a, body header nav#user-nav a { color: var(--ps-muted) !important; font-family: var(--ps-font) !important; font-weight: 700; }
header nav a:hover { color: var(--ps-ink) !important; }
header nav#user-nav .tabs > a.selected, header nav#user-nav > a.selected {
  color: var(--ps-ink) !important; font-weight: 800;
  box-shadow: inset 0 -3px 0 var(--ps-leaf);
}

/* A blog's own title and its posts */
body#collection header h1, body#post header h1, body#subpage header h1 {
  font-family: var(--ps-font); font-weight: 1000; letter-spacing: -.012em;
}
body#collection header h1 a, body#post header h1 a, body#subpage header h1 a { color: var(--ps-ink); }
/* Handwritten post titles (Delius Swash Caps, as in the game's Woodland reader). */
body#post article h2#title, body#subpage article h2#title {
  font-family: var(--ps-hand); font-weight: 400; font-size: 1.45em; line-height: 1.3;
  color: var(--ps-ink); letter-spacing: 0;
}
article h2.post-title { font-family: var(--ps-hand); font-weight: 400; letter-spacing: 0; }
.post-title a:link, .post-title a:visited { color: var(--ps-ink); }
.post-title time, .post-title time a:link, .post-title time a:visited, .post-title + .time { color: var(--ps-muted); }
article#post-body a, article .e-content a { color: var(--ps-olive); }

/* Buttons */
.btn.cta, button.cta, input.cta, input.submit, input[type=submit],
.row.signinbtns .loginbtn.btn {
  background: var(--ps-olive) !important; border: 1px solid var(--ps-olive) !important;
  color: var(--ps-on-olive) !important; border-radius: 12px !important;
  font-family: var(--ps-font) !important; font-weight: 800;
}
.btn.cta:hover, button.cta:hover, input.cta:hover, input.submit:hover, input[type=submit]:hover,
.row.signinbtns .loginbtn.btn:hover { background: var(--ps-olive-2) !important; border-color: var(--ps-olive-2) !important; }
.btn.cta.secondary, input[type=submit].secondary {
  background: transparent !important; color: var(--ps-olive) !important; border-color: var(--ps-line-2) !important;
}
.btn.cta.secondary:hover, input[type=submit].secondary:hover { background: var(--ps-sage) !important; }
.btn.cta.disabled, input[type=submit]:disabled { opacity: .55; }
ol.pinned-list .pinned-controls button.pinned-unpin, body#pad #target a.upgrade-prompt { color: var(--ps-olive); }

/* Fields */
body:not(.dark) input[type=text], body:not(.dark) input[type=email], body:not(.dark) input[type=password],
body:not(.dark) input[type=url], body:not(.dark) select, body:not(.dark) textarea.inputform {
  background: var(--ps-surface); color: var(--ps-text); border: 1px solid var(--ps-line-2);
  border-radius: 12px; font-size: 16px;
}
input:focus, select:focus, textarea.inputform:focus {
  border-color: var(--ps-leaf) !important; box-shadow: 0 0 0 3px rgba(127, 156, 71, .25) !important; outline: 0;
}

/* Notices, footer */
.alert, .alert.success, .alert.info { background: var(--ps-sage); color: var(--ps-ink); border: 1px solid var(--ps-sage-2); border-radius: 12px; }
footer, footer a, footer h3 a.home { color: var(--ps-muted) !important; }
footer hr, hr { border-color: var(--ps-line); }

# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans deployment apply` renders it and refuses to overwrite one
# that has been modified locally. Change {{ configFile }} or secrets.enc.yaml.
#
# Matrix Authentication Service: the thing that actually logs a member in.
# Clients speak OAuth 2.0 to this service, it redirects to the identity
# provider, imports the claims, provisions the account and issues the Matrix
# access token. The homeserver beside it never learns how to log anyone in.
#
# Every key below was read from MAS's own source or configuration reference,
# not recalled. A key with its own citation names the tag it was read at; any
# other key was read from docs/reference/configuration.md at tag v1.24.0 on
# 2026-09-15.
#
# TWO THINGS HERE ARE ONE-WAY DOORS.
#
#   secrets.encryption encrypts database fields and cookies. Changing it after
#   members exist makes every encrypted field and cookie unrecoverable. Back it
#   up with the database, not instead of it.
#
#   claims_imports.localpart becomes the permanent local part of a member's
#   identifier. Renaming them at the identity provider afterwards does not
#   rename the identifier.
#
# NOTHING HAS TO BE RUN BY HAND TO BRING THIS UP. `mas-cli server`, which is
# what the compose file runs, applies pending database migrations and syncs
# this file's clients and upstream providers into the database on start;
# `--no-migrate` and `--no-sync` turn each off and neither is passed. Read from
# the `server` command's own reference at tag v1.24.0 on 2026-09-15.
#
# THE COMMAND THAT HAS TEETH IS THE SEPARATE ONE. `mas-cli config sync --prune`
# deletes anything absent from this file, so running it against a partial
# config deletes the upstream provider below, which is every member's only way
# in. A start never prunes; that flag only exists on the standalone command.

http:
  # Public URL base used when building absolute public URLs. MAS answers on
  # the same hostname as the homeserver API: the gateway splits the three
  # compatibility login paths off to this service and gives it everything that
  # is not the homeserver's.
  public_base: {{ quote (printf "%s/" .PublicURL) }}
  issuer: {{ quote (printf "%s/" .PublicURL) }}
  # The mesh, never a host address, so the gateway role can move without
  # rewriting this file.
  trusted_proxies:
    - {{ .TrustedProxies }}
  listeners:
    - name: web
      resources:
        # discovery and oauth are not optional here: the homeserver's
        # matrix_authentication_service.endpoint points at this listener and
        # Synapse's manual says that endpoint must have both mounted.
        - name: discovery
        - name: human
        - name: oauth
        # compat is what answers the three /_matrix/client/*/login, /logout and
        # /refresh paths the gateway sends here.
        - name: compat
        - name: graphql
        - name: assets
          # Where the image puts them. The default is relative to the working
          # directory, which is / in this image, so it is spelled out: read from
          # the Dockerfile at tag v1.24.0, which copies the built assets to
          # /usr/local/share/mas-cli/.
          path: /usr/local/share/mas-cli/assets/
      binds:
        - address: "[::]:{{ (index .ServicePorts "mas") }}"
      proxy_protocol: false
    # The admin API and nothing else (crates/config/src/sections/http.rs:259-299
    # at tag v1.28.0). Compose publishes it on the mesh address only, so the
    # gateway never proxies to it, and the web listener above does not mount
    # adminapi. The port is the same 18010 as the mas_admin_url value in
    # blueprint.yaml and the second published port in compose.yaml.
    - name: admin
      resources:
        - name: adminapi
      binds:
        - address: "[::]:18010"
      proxy_protocol: false

database:
  host: {{ quote .DBHost }}
  port: {{ .DBPort }}
  username: {{ quote .DBUser }}
  password: {{ quote .DBPassword }}
  # Its own database beside the homeserver's, not its own role: one app, one
  # credential is this toolkit's rule everywhere else and MAS is not an
  # exception to it. A shared database would be worse than a shared role,
  # because both services define a `users` table.
  database: {{ quote (index .Databases "mas") }}

matrix:
  # The homeserver's server_name, which is the name inside every identifier.
  homeserver: {{ quote .ServerName }}
  # The homeserver's own address, inside this stack. `app` is the compose
  # service, so this never leaves the host.
  endpoint: {{ quote (printf "http://app:%d/" .App.Port) }}
  # The same string as homeserver.yaml's matrix_authentication_service.secret.
  # It authenticates this service to the homeserver, which means it can perform
  # admin actions there, so it is high entropy and it is not shared with
  # anything else.
  secret: {{ quote (.Secret "mas_matrix_secret") }}

secrets:
  # A 32-byte hex encoded key, which is the form MAS states. See the one-way
  # door note at the top of this file.
  encryption: {{ quote (.Secret "mas_encryption_secret") }}
  keys:
    # At least one RSA key must be configured, per MAS's reference. This one
    # signs the tokens the service issues.
    - key: |
{{ indent 8 (.Secret "mas_signing_key") }}

# No local password database. The identity provider is the only way in, which
# is what makes the group restriction there the whole of the access policy.
passwords:
  enabled: false

account:
  password_registration_enabled: false
  password_change_allowed: false
  password_recovery_enabled: false
{{- $admins := false }}
{{- range ($.Consumers "matrix-homeserver") }}{{ if index .Secrets "mas_admin_client_secret" }}{{ $admins = true }}{{ end }}{{ end }}
{{ if $admins }}
# Each engagement app that links to this homeserver gets an admin client, with
# the secret it shares (mas_admin_client_secret, stored under that app and
# rotated with it). A static client may use every grant type
# (crates/storage-pg/src/oauth2/client.rs:585-640), and admin_clients is what
# lets client credentials carry urn:mas:admin
# (policies/authorization_grant/authorization_grant.rego:63-68). The client
# takes its token from /oauth2/token on the web listener and uses it on the
# admin listener. A start re-syncs these clients from this file
# (crates/cli/src/sync.rs:405-440), so a rotated secret takes effect when MAS
# restarts. A client removed from the file keeps its database row but leaves
# admin_clients, so it can no longer get admin access. The keys are read from
# crates/config/src/sections/clients.rs:59-99,127-135 and
# crates/config/src/sections/policy.rs:143-145, all at tag v1.28.0.
clients:
{{- range ($.Consumers "matrix-homeserver") }}
{{- if index .Secrets "mas_admin_client_secret" }}
  - client_id: {{ stableULID (printf "%s-mas-admin" .Name) }}
    client_auth_method: client_secret_basic
    client_secret: {{ jsonquote (index .Secrets "mas_admin_client_secret") }}
{{- end }}
{{- end }}
policy:
  data:
    admin_clients:
{{- range ($.Consumers "matrix-homeserver") }}
{{- if index .Secrets "mas_admin_client_secret" }}
      - {{ stableULID (printf "%s-mas-admin" .Name) }}
{{- end }}
{{- end }}
{{- else }}
# No engagement app links to this homeserver, so MAS has no admin client.
{{- end }}
{{ if .SMTP.Host }}
# The deployment's smtp block, which sends the codes that verify a member's
# email address. Every key was read from crates/config/src/sections/email.rs
# at tag v1.28.0: mode is plain, starttls or tls, and from and reply_to must
# each parse as a mailbox, so a sender name is a quoted string. MAS requires
# username and password together or neither.
{{- $from := .SMTPSender }}
{{- if .SMTP.FromName }}{{ $from = printf "%s <%s>" (quote .SMTP.FromName) .SMTPSender }}{{ end }}
email:
  from: {{ jsonquote $from }}
  reply_to: {{ jsonquote $from }}
  transport: smtp
  mode: {{ if eq .SMTP.Security "none" }}plain{{ else }}{{ .SMTP.Security }}{{ end }}
  hostname: {{ jsonquote .SMTP.Host }}
  port: {{ .SMTP.Port }}
{{- if .SMTP.Username }}
  username: {{ jsonquote .SMTP.Username }}
  password: {{ jsonquote .SMTP.Password }}
{{- end }}
{{- else }}
# NO EMAIL SECTION, because this app resolves no SMTP host. MAS keeps its
# blackhole transport and discards every mail, the codes that verify a
# member's email address among them.
{{- end }}
{{ if .OIDC.Present }}
upstream_oauth2:
  providers:
    # THE REDIRECT URI THE CLIENT AT THE IDENTITY PROVIDER ALLOWS IS
    # {{ .OIDC.RedirectURL }}
    # `paisans deployment apply` creates the client with it, and `paisans init` names it
    # while the client is still owed, which is before this file exists.
    # The id below is part of that URL, which is why it is derived from the
    # app's name and stays the same every time this file is rendered rather
    # than being generated fresh and silently invalidating the client.
    - id: {{ (stableULID .App.Name) }}
      issuer: {{ jsonquote .OIDC.Issuer }}
      client_id: {{ jsonquote .OIDC.ClientID }}
      client_secret: {{ jsonquote .OIDC.ClientSecret }}
      token_endpoint_auth_method: client_secret_basic
      # Always send an S256 code challenge. The client at the identity
      # provider has PKCE on, which refuses any request without one, so the
      # challenge must not depend on what discovery advertises: `always` is
      # the S256 mode (crates/config/src/sections/upstream_oauth2.rs:420-436
      # and crates/cli/src/sync.rs:289-298 at tag v1.24.0), where `auto`, the
      # default, sends one only when discovery lists S256.
      pkce_method: always
      scope: "openid profile email"
      claims_imports:
        localpart:
          # require, not suggest: a member with no preferred_username should
          # fail loudly at first login rather than quietly receive a generated
          # identifier they are then stuck with. See the one-way door note.
          action: require
          template: {{ quote "{{ user.preferred_username }}" }}
        displayname:
          action: suggest
          template: {{ quote "{{ user.name }}" }}
        email:
          action: suggest
          template: {{ quote "{{ user.email }}" }}
{{- else }}
# NO UPSTREAM PROVIDER, because this app has no client recorded at the identity
# provider. Local passwords are off, so nobody can log in at all until
# oidc_clients.{{ .App.Name }} is filled in and this file is rendered again.
# `paisans init` reports that client as owed for exactly this reason.
{{- end }}
